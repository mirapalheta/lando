# Terraform files
.terraform
# .terraform.lock.hcl is intentionally committed — do not ignore it
*.tfstate
*.tfstate.*
*.tfplan
plan.txt
*.tfvars
!terraform.tfvars.example
# Backend config — backend.tf and backend.hcl are user-enabled after the
# first apply creates the state container. Only the .example templates
# are committed; a fresh checkout has no backend.tf and defaults to local
# state, which is what we want during bootstrap.
backend.tf
!backend.tf.example
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local development
.env
local.settings.json
